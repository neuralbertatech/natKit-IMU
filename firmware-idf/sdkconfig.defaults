# ⚠️ THIS FILE IS READ ONCE, when `sdkconfig` does not exist.
#
# ESP-IDF generates `sdkconfig` from these defaults on the first configure and
# then never consults them again. So adding a line here has NO EFFECT on any
# checkout that has already been built — including yours. There is no warning; the
# option is simply absent from the generated config.
#
# That has bitten this project twice over, silently:
#   * CONFIG_ETH_SPI_ETHERNET_W5500 was added with the Ethernet uplink (0b5f303)
#     and never applied, so `ethernet_net.cpp` failed to compile —
#     `eth_w5500_config_t` undeclared — and the whole firmware would not build.
#   * CONFIG_PARTITION_TABLE_CUSTOM is TEC-NATKIT-49's fix for the 1 MB app
#     partition. It sat here inert while the build kept using the stock table,
#     which is the very thing the ticket was raised about.
#
# After editing this file: `rm sdkconfig && idf.py reconfigure`, then check the
# option actually landed:  grep '^CONFIG_YOUR_OPTION' sdkconfig
#
# `sdkconfig` is gitignored, so it is safe to delete — it is generated, and these
# defaults are the source of truth.

# Shared defaults for every role and every target.
#
# Only deliberate deviations from the ESP-IDF defaults belong here -- nothing
# copied across "just in case". `sdkconfig` itself is generated per target and
# is gitignored, so this file (plus sdkconfig.defaults.<target>) is the only
# committed source of truth for the build config.

# The IMU frame path is stack-hungry (the Arduino image gave its send task
# 18 KB) and the default 3584 B main task stack is not enough headroom for the
# sh2 driver's callbacks landing on it. Matches natVR/firmware.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# A 1 ms FreeRTOS tick, matching arduino-esp32's default and therefore the timing
# the BNO08x has actually been streaming under.
#
# This is NOT a preference. The sh2 HAL waits for the hub's INT line by polling
# with a 1 ms delay, up to 500 times, before giving up and resetting the hub. At
# the IDF default of 100 Hz the shortest possible delay is 10 ms, which turns
# that 500 ms budget into 5 s and coarsens every single SHTP exchange tenfold --
# on a hub that has already proven fragile about timing.
CONFIG_FREERTOS_HZ=1000

# --- SPI Ethernet, on EVERY target rather than only the S3 -------------------
#
# The IDF's own esp_eth, explicitly. The vendored copies were deleted from
# natKit-IMU in 891cc38 and were what broke the earlier combined-framework
# build; nothing should reintroduce them.
#
# ⚠️ These live here, not in sdkconfig.defaults.esp32s3, because of the epic's
# own invariant: every source in main/ compiles into every image, so a role or a
# target cannot rot unnoticed. ethernet_net.cpp references esp_eth_mac_new_w5500
# and friends, and those symbols only exist when the driver is selected -- so
# scoping this to one target broke the classic ESP32 build the moment the file
# was added. The cost on a target that will never use it is a few KB of flash in
# a partition that is 34% free; the cost of the alternative is a build that only
# fails when someone happens to pick the other chip.
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# --- Partition table (TEC-NATKIT-49) -----------------------------------------
#
# The stock single-factory table gives the app 1 MB, and the primary measured
# 93.2% of that on 2026-08-17 with 3 MB of the flash unused. partitions.csv
# widens `factory` to 3 MB and leaves nvs/phy_init byte-identical, so a node's
# NVS-persisted report mask survives the change.
#
# ⚠️ ESP-IDF reads sdkconfig.defaults* ONLY when the generated sdkconfig does not
# exist yet, so picking this up means `rm build/<target>-<role>/sdkconfig` first.
# build-role.sh warns when a defaults file is newer than the generated config.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- SNTP poll interval (TEC-NATKIT-48) --------------------------------------
#
# ⚠️ 60 s, against an IDF default of ONE HOUR, and the default is what the ticket
# is about. Between polls the hub's clock free-runs on its crystal, and MEASURED on
# this board it drifts about -57 ms/hour (~16 ppm). Every sample in every recording
# is stamped from that clock by rewriteFrameTimestamps, so the whole rig inherits
# the drift and then jumps when the next poll corrects it -- which is exactly the
# ~38 ms wander observed across three runs on 2026-08-17.
#
# At 60 s the free-run error is ~1 ms instead of ~57, for one small UDP exchange a
# minute against an NTP server on the same LAN. 15 s is the RFC 4330 floor if this
# ever needs to be tighter; it should not, because node-to-node coherence does not
# come from here -- it comes from the ESP-NOW timing master, and that is already
# 60-100 us.
CONFIG_LWIP_SNTP_UPDATE_DELAY=60000

# --- Transmit power: pinned, and the sweep OFF (TEC-NATKIT-37) --------------
#
# ⚠️ THIS IS A KNOWN-GOOD STATE THAT WAS LOST ONCE ALREADY, which is why it is
# here rather than in somebody's local sdkconfig. TEC-NATKIT-37 closed with the
# bench recorded as "both leaves pinned at 8.5 dBm with NATKIT_TX_POWER_SWEEP
# off", and a warning: if the sweep is re-enabled, watch for it choosing very
# different powers per node, because that is what produced the asymmetry the
# ticket was originally filed about.
#
# That warning came true on 2026-08-24. `NATKIT_TX_POWER_SWEEP` defaults to y in
# Kconfig and nothing here overrode it, so a regenerated sdkconfig silently
# turned it back on -- and the three leaves settled at 2.0, 8.5 and 19.5 dBm,
# 17 dB apart. The symptom is not a board that fails: it is EXACTLY TWO of three
# leaves working, with which one loses rotating between them as each sweep
# re-runs. That reads like failing hardware and is a configuration difference.
#
# Pinning all leaves to one power removes the asymmetry at the source. 34
# quarter-dBm = 8.5 dBm, which is the level the ticket measured. Do not "fix"
# this by raising it: the sweep's own help records 19.5 dBm delivering 0.4
# frames/s against 2 dBm delivering 8.5, because ~+9 dBm arriving at a 2.4 GHz
# front end saturates it, and raising both leaves uniformly took 10.6 frames/s
# each down to 2.6 and 6.2.
CONFIG_NATKIT_TX_POWER_SWEEP=n
CONFIG_NATKIT_TX_POWER_QUARTER_DBM=34
